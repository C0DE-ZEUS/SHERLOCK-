# Sherlock backend configuration. Every value is optional: the defaults are
# shown. Copy this file to backend/.env and start the backend with
#   .venv\Scripts\python.exe -m uvicorn app.main:app --env-file .env --port 8000
# Never commit your real .env file.

# ---- Contextual AI detection -------------------------------------------------
# ollama            -> a local Ollama server (development default)
# openai_compatible -> any OpenAI-style /v1/chat/completions server you run or pay for
# none              -> AI detection off (rule-based detection still works)
SHERLOCK_AI_PROVIDER=ollama
SHERLOCK_AI_BASE_URL=http://localhost:11434
SHERLOCK_AI_MODEL=qwen3:4b
# Only for openai_compatible servers that need a key. Leave empty otherwise.
SHERLOCK_AI_API_KEY=
# Seconds to wait for one model reply (CPU inference is slow).
SHERLOCK_AI_TIMEOUT_SECONDS=180
# Total characters of document text sent to the model per scan, and per call.
SHERLOCK_AI_MAX_CHARS=6000
SHERLOCK_AI_CHUNK_CHARS=2000

# ---- Server-side OCR (optional; browsers OCR images when this is missing) -----
# SHERLOCK_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SHERLOCK_OCR_LANG=eng

# ---- Limits ------------------------------------------------------------------
SHERLOCK_MAX_UPLOAD_MB=10
SHERLOCK_MAX_PDF_PAGES=30
SHERLOCK_SESSION_TTL_MINUTES=30
SHERLOCK_MAX_SESSIONS=20
# Scans + redactions per client IP per 10 minutes (0 disables the limit).
SHERLOCK_RATE_LIMIT=30
SHERLOCK_MAX_CONCURRENT_JOBS=2

# ---- Deployment --------------------------------------------------------------
# local | hosted (hosted changes privacy wording and hides /docs)
SHERLOCK_DEPLOYMENT=local
# Comma-separated browser origins allowed to call the API.
SHERLOCK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve a built frontend from the backend (single-URL deployments).
# SHERLOCK_STATIC_DIR=../frontend/dist
# Working folder; only Sherlock's own random session folders in it are deleted.
# SHERLOCK_TEMP_DIR=C:\Users\you\AppData\Local\Temp\sherlock-work
