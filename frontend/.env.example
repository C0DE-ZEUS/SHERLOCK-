# Sherlock frontend configuration (Vite reads .env files automatically).
# Copy to frontend/.env.local for local overrides, or .env.production for builds.

# Base URL of the backend API, without a trailing slash.
# Leave EMPTY when the backend serves the frontend (Docker / single URL) or in
# development (Vite proxies /api to http://127.0.0.1:8000).
# Set it only when the frontend and backend are on different domains, e.g.
#   VITE_API_BASE=https://sherlock-api.example.com
VITE_API_BASE=

# Optional: link to your GitHub repository in the footer. Leave empty to hide it.
VITE_GITHUB_URL=
